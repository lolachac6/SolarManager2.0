<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="800.0" prefWidth="1200.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="components.pantallaClientes.PantallaClientesController">

    <stylesheets>
        <URL value="@plantillageneral.css" />
    </stylesheets>

    <children>

        <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <!-- CINTA SUPERIOR -->

            <top>
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color:#f4f4f4; -fx-padding:10;">

                    <Button fx:id="btnVolver" text="← Volver" />

                    <Label style="-fx-font-size:18px; -fx-font-weight:bold;" text="Solar Manager" />

                    <Pane HBox.hgrow="ALWAYS" />

                </HBox>
            </top>



            <!-- MENU LATERAL -->

            <left>

                <VBox alignment="TOP_CENTER" prefWidth="200" spacing="10" style="-fx-background-color:#e6e9ef;                              -fx-padding:85 15 15 15;                              -fx-border-color:#d0d0d0;                              -fx-border-width:2;                              -fx-background-radius:5;                              -fx-border-radius:5;">

                    <BorderPane.margin>
                        <Insets bottom="65.0" left="15.0" right="15.0" top="90.0" />
                    </BorderPane.margin>

                    <Label style="-fx-font-weight:bold;" text="Inicio" />

                    <Button maxWidth="Infinity" text="Clientes" />
                    <Button maxWidth="Infinity" text="Comerciales" />
                    <Button maxWidth="Infinity" text="Proveedores" />
                    <Button maxWidth="Infinity" text="Stock" />
                    <Button maxWidth="Infinity" text="Presupuestos" />

                </VBox>

            </left>



            <!-- DASHBOARD CENTRAL -->

            <center>

                <VBox spacing="20" style="-fx-padding:20;">

                    <!-- TITULO -->

                    <Label fx:id="lblTituloPagina" style="-fx-font-size:22px; -fx-font-weight:bold;" text="Clientes" />


                    <!-- TABLA DE CLIENTES -->

                    <TableView fx:id="tablaClientes" style="-fx-border-color:#d0d0d0;                                       -fx-border-width:2;" VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="colId" prefWidth="70" text="ID" />
                            <TableColumn fx:id="colNombre" prefWidth="120" text="Nombre" />
                            <TableColumn fx:id="colApellidos" prefWidth="140" text="Apellidos" />
                            <TableColumn fx:id="colTelefono" prefWidth="110" text="Teléfono" />
                            <TableColumn fx:id="colEmail" prefWidth="160" text="Email" />
                            <TableColumn fx:id="colDireccion" prefWidth="160" text="Dirección" />
                            <TableColumn fx:id="colTipoCliente" prefWidth="120" text="Tipo Cliente" />
                            <TableColumn fx:id="colDni" prefWidth="110" text="DNI" />
                            <TableColumn fx:id="colCif" prefWidth="110" text="CIF" />
                            <TableColumn fx:id="colObservaciones" prefWidth="180" text="Observaciones" />
                            <TableColumn fx:id="colIdComercialAsignado" prefWidth="120" text="ID Comercial" />

                        </columns>

                    </TableView>



                    <!-- ESPACIO FLEXIBLE REDUCIDO -->

                    <Pane prefHeight="100" style="-fx-background-color:white;                                  -fx-border-color:#d0d0d0;                                  -fx-border-width:2;                                  -fx-border-radius:5;                                  -fx-background-radius:5;" />



                    <!-- BOTONES INFERIORES -->

                    <HBox alignment="CENTER_RIGHT" spacing="10">

                        <Button fx:id="btnGuardar" style="-fx-background-color:#2f6fda; -fx-text-fill:white;" text="Guardar" />

                        <Button fx:id="btnModificar" text="Modificar" />

                        <Button fx:id="btnCancelar" text="Cancelar" />

                    </HBox>

                </VBox>

            </center>

        </BorderPane>

    </children>

</AnchorPane>
