<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="components.form.datosPersona.FormPersonaController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Datos personales" styleClass="form-section-title"/>

    <GridPane hgap="10" vgap="10">

        <columnConstraints>
            <ColumnConstraints percentWidth="15"/>
            <ColumnConstraints percentWidth="35" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="15"/>
            <ColumnConstraints percentWidth="35" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"/>

        <Label text="Apellidos:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="txtApellidos" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="Infinity"/>

        <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity"/>

        <Label text="Email:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="txtEmail" GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="Infinity"/>

    </GridPane>

    <Label text="Datos del cliente" styleClass="form-section-title"/>

    <GridPane hgap="10" vgap="10">

        <columnConstraints>
            <ColumnConstraints percentWidth="15"/>
            <ColumnConstraints percentWidth="35" hgrow="ALWAYS"/>
            <ColumnConstraints percentWidth="15"/>
            <ColumnConstraints percentWidth="35" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtId" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"/>

        <Label text="Tipo cliente:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <ComboBox fx:id="cbTipoCliente" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="Infinity"/>

        <Label text="DNI:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtDni" GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity"/>

        <Label text="CIF:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="txtCif" GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="Infinity"/>

        <Label text="Cuenta bancaria:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtCuenta" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity"/>

        <Label text="Comercial asignado:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <TextField fx:id="txtIdComercial" GridPane.columnIndex="3" GridPane.rowIndex="2" maxWidth="Infinity"/>

        <Label text="Observaciones:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextArea fx:id="txtObservaciones"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="3"
                  GridPane.columnSpan="3"
                  maxWidth="Infinity"
                  prefRowCount="3"/>

    </GridPane>

</VBox>