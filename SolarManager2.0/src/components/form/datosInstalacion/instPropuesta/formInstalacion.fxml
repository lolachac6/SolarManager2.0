<AnchorPane id="AnchorPane" prefHeight="256.0" prefWidth="589.0" styleClass="mainFxmlClass" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="components.form.datosPersona.datosInstalacion.FormInstalacionController">

    <stylesheets>
        <URL value="@forminstalacion.css" />
    </stylesheets>

    <children>

        <GridPane hgap="10" prefHeight="216.0" prefWidth="545.0" vgap="10" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="20">

            <columnConstraints>
                <ColumnConstraints maxWidth="181.0" minWidth="160.0" prefWidth="181.0" />
                <ColumnConstraints hgrow="ALWAYS" maxWidth="374.0" minWidth="354.0" prefWidth="354.0" />
            </columnConstraints>

            <children>

                <Label text="Potencia instalada (kW):" GridPane.columnIndex="0" GridPane.rowIndex="0" />

                <TextField fx:id="txtPotenciaInstalada" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Número de paneles:" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                <TextField fx:id="txtNumeroPaneles" GridPane.columnIndex="1" GridPane.rowIndex="1" />

