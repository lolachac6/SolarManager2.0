                <TextField fx:id="txtAhorroEstimado" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Dirección instalación:" GridPane.columnIndex="0" GridPane.rowIndex="4" />

                <TextArea fx:id="txtDireccionInstalacion" prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="4" />

            </children>
         <rowConstraints>
            <RowConstraints />
