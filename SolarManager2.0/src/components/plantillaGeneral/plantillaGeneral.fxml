<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane"
            prefHeight="400.0"
            prefWidth="600.0"
            styleClass="mainFxmlClass"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="components.pantallaClientes.PantallaClientesController">

    <stylesheets>
        <URL value="@pantallaclientes.css"/>
    </stylesheets>

    <children>

        <BorderPane AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0"
                    AnchorPane.topAnchor="0">

            <!-- BARRA SUPERIOR -->

            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="10"
                      style="-fx-background-color:#f4f4f4; -fx-padding:10;">

                    <Button fx:id="btnVolver" text="← Volver"/>

                    <Label text="Solar Manager"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

                    <Pane HBox.hgrow="ALWAYS"/>

                </HBox>
            </top>



            <!-- MENU LATERAL -->

            <left>

                <VBox alignment="TOP_CENTER"
                      prefWidth="200"
                      spacing="10"
                      style="-fx-background-color:#e6e9ef;
                             -fx-padding:85 15 15 15;
                             -fx-border-color:#d0d0d0;
                             -fx-border-width:2;
                             -fx-background-radius:5;
                             -fx-border-radius:5;">

                    <BorderPane.margin>
                        <Insets bottom="65" left="15" right="15" top="90"/>
                    </BorderPane.margin>

                    <Label text="Inicio"
                           style="-fx-font-weight:bold;"/>

                    <Button text="Clientes" maxWidth="Infinity"/>
                    <Button text="Comerciales" maxWidth="Infinity"/>
                    <Button text="Proveedores" maxWidth="Infinity"/>
                    <Button text="Stock" maxWidth="Infinity"/>
                    <Button text="Presupuestos" maxWidth="Infinity"/>

                </VBox>

            </left>



            <!-- CONTENIDO CENTRAL -->

            <center>

                <VBox spacing="20" style="-fx-padding:20;">

                    <!-- TITULO -->

                    <Label fx:id="lblTituloPagina"
                           text="Listado de Clientes"
                           style="-fx-font-size:22px; -fx-font-weight:bold;" />


                    <!-- TABLA CLIENTES -->

                    <TableView fx:id="tablaClientes"
                               VBox.vgrow="ALWAYS"
                               style="-fx-border-color:#d0d0d0;
                                      -fx-border-width:2;">

                        <columns>

                            <TableColumn text="#" prefWidth="40"/>
                            <TableColumn text="ID Cliente" prefWidth="90"/>
                            <TableColumn text="Nombre" prefWidth="120"/>
                            <TableColumn text="Apellidos" prefWidth="150"/>
                            <TableColumn text="Teléfono" prefWidth="120"/>
                            <TableColumn text="Email" prefWidth="180"/>
                            <TableColumn text="Dirección" prefWidth="180"/>
                            <TableColumn text="Tipo Cliente" prefWidth="120"/>
                            <TableColumn text="DNI" prefWidth="100"/>
                            <TableColumn text="CIF" prefWidth="100"/>
                            <TableColumn text="Observaciones" prefWidth="200"/>
                            <TableColumn text="ID Comercial" prefWidth="120"/>

                        </columns>

                    </TableView>



                    <!-- CONTENEDORES INFERIORES -->

                    <GridPane hgap="20" vgap="20">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <rowConstraints>
                            <RowConstraints percentHeight="50"/>
                            <RowConstraints percentHeight="50"/>
                        </rowConstraints>

                        <VBox fx:id="contenedorInferior1"
                              prefHeight="200"
                              style="-fx-background-color:white;
                                     -fx-border-color:#d0d0d0;
                                     -fx-border-width:2;
                                     -fx-padding:15;
                                     -fx-background-radius:5;
                                     -fx-border-radius:5;"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="0">

                            <Label text="Panel 1"/>

                        </VBox>


                        <VBox fx:id="contenedorInferior2"
                              prefHeight="200"
                              style="-fx-background-color:white;
                                     -fx-border-color:#d0d0d0;
                                     -fx-border-width:2;
                                     -fx-padding:15;
                                     -fx-background-radius:5;
                                     -fx-border-radius:5;"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="0">

                            <Label text="Panel 2"/>

                        </VBox>


                        <VBox fx:id="contenedorInferior3"
                              prefHeight="200"
                              style="-fx-background-color:white;
                                     -fx-border-color:#d0d0d0;
                                     -fx-border-width:2;
                                     -fx-padding:15;
                                     -fx-background-radius:5;
                                     -fx-border-radius:5;"
                              GridPane.columnIndex="0"
                              GridPane.rowIndex="1">

                            <Label text="Panel 3"/>

                        </VBox>


                        <VBox fx:id="contenedorInferior4"
                              prefHeight="200"
                              style="-fx-background-color:white;
                                     -fx-border-color:#d0d0d0;
                                     -fx-border-width:2;
                                     -fx-padding:15;
                                     -fx-background-radius:5;
                                     -fx-border-radius:5;"
                              GridPane.columnIndex="1"
                              GridPane.rowIndex="1">

                            <Label text="Panel 4"/>

                        </VBox>

                    </GridPane>



                    <!-- ESPACIO FLEXIBLE -->

                    <Pane VBox.vgrow="ALWAYS"
                          style="-fx-background-color:white;
                                 -fx-border-color:#d0d0d0;
                                 -fx-border-width:2;
                                 -fx-border-radius:5;
                                 -fx-background-radius:5;" />


                    <!-- BOTONES -->

                    <HBox alignment="CENTER_RIGHT" spacing="10">

                        <Button fx:id="btnGuardar"
                                text="Guardar"
                                style="-fx-background-color:#2f6fda; -fx-text-fill:white;"/>

                        <Button fx:id="btnEditar"
                                text="Editar"/>

                        <Button fx:id="btnCancelar"
                                text="Cancelar"/>

                    </HBox>

                </VBox>

            </center>

        </BorderPane>

    </children>

</AnchorPane>