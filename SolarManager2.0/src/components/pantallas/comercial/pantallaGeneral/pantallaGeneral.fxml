<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="800.0"
            prefWidth="1200.0"
            styleClass="mainFxmlClass"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="components.pantallas.comercial.pantallaGeneral.PantallaGeneralController">

    <!-- 🔥 IMPORTANTE: CSS -->
    <stylesheets>
        <URL value="@plantillageneral.css"/>
    </stylesheets>

    <children>

        <BorderPane AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0"
                    AnchorPane.topAnchor="0">

            <!-- ===================== -->
            <!-- CABECERA -->
            <!-- ===================== -->
            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="10"
                      style="-fx-background-color:#f4f4f4; -fx-padding:10;">

                    <Button text="← Volver"/>

                    <Label text="Solar Manager"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

                    <Pane HBox.hgrow="ALWAYS"/>

                </HBox>
            </top>

            <!-- ===================== -->
            <!-- MENU LATERAL -->
            <!-- ===================== -->
            <left>
                <VBox alignment="TOP_CENTER"
                      prefWidth="200"
                      spacing="10"
                      style="
                            -fx-background-color:#e6e9ef;
                            -fx-padding:85 15 15 15;
                            -fx-border-color:#d0d0d0;
                            -fx-border-width:2;
                            -fx-background-radius:5;
                            -fx-border-radius:5;">

                    <BorderPane.margin>
                        <Insets top="90" right="15" bottom="65" left="15"/>
                    </BorderPane.margin>

                    <Label text="Inicio"
                           style="-fx-font-weight:bold;"/>

                    <Button text="Clientes"
                            styleClass="menu-button"
                            maxWidth="Infinity"
                            onAction="#mostrarClientes"/>

                    <Button text="Instalaciones"
                            styleClass="menu-button"
                            maxWidth="Infinity"
                            onAction="#mostrarInstalaciones"/>

                    <Button text="Presupuestos"
                            styleClass="menu-button"
                            maxWidth="Infinity"
                            onAction="#mostrarPresupuestos"/>

                </VBox>
            </left>

            <!-- ===================== -->
            <!-- CONTENIDO -->
            <!-- ===================== -->
            <center>
                <VBox spacing="20" style="-fx-padding:20;">

                    <!-- TITULO -->
                    <Label text="Área Comercial"
                           style="-fx-font-size:22px; -fx-font-weight:bold;"/>

                    <!-- ===================== -->
                    <!-- DASHBOARD -->
                    <!-- ===================== -->
                    <GridPane hgap="30" vgap="30">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>

                        <rowConstraints>
                            <RowConstraints percentHeight="100"/>
                        </rowConstraints>

                        <!-- CLIENTES -->
                        <Button fx:id="btnClientes"
                                text="Clientes"
                                styleClass="dashboard-button"
                                contentDisplay="TOP"
                                maxWidth="Infinity"
                                maxHeight="Infinity"
                                onAction="#abrirAltaCliente"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="0"/>

                        <!-- INSTALACIONES -->
                        <Button fx:id="btnInstalaciones"
                                text="Instalaciones"
                                styleClass="dashboard-button"
                                contentDisplay="TOP"
                                maxWidth="Infinity"
                                maxHeight="Infinity"
                                onAction="#abrirCalculoInstalacion"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="0"/>

                    </GridPane>

                    <!-- ===================== -->
                    <!-- PANEL TABLA -->
                    <!-- ===================== -->
                    <Pane fx:id="panelTabla"
                          VBox.vgrow="ALWAYS"
                          style="
                            -fx-background-color:white;
                            -fx-border-color:#d0d0d0;
                            -fx-border-width:2;
                            -fx-border-radius:5;
                            -fx-background-radius:5;"/>

                </VBox>
            </center>

        </BorderPane>

    </children>

</AnchorPane>