<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="800.0"
            prefWidth="1200.0"
            maxHeight="800.0"
            maxWidth="1200.0"
            minHeight="800.0"
            minWidth="1200.0"
            styleClass="mainFxmlClass"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="components.pantallas.comercial.pantallaGeneral.PantallaGeneralController">

    <stylesheets>
        <URL value="@plantillageneral.css"/>
    </stylesheets>

    <children>

        <BorderPane AnchorPane.topAnchor="0"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0">

            <!-- CABECERA -->
            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="15"
                      prefHeight="60"
                      style="-fx-background-color:#f4f4f4; -fx-padding:10 20 10 20;">

                    <Button text="← Volver" prefHeight="35"/>

                    <Label text="Solar Manager"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

                    <Pane HBox.hgrow="ALWAYS"/>

                </HBox>
            </top>

            <!-- MENU LATERAL -->
            <left>
                <VBox alignment="TOP_CENTER"
                      prefWidth="200"
                      spacing="10"
                      style="
                        -fx-background-color:#e6e9ef;
                        -fx-padding:85 15 15 15;
                        -fx-border-color:#d0d0d0;
                        -fx-border-width:2;">

                    <Label text="Inicio" style="-fx-font-weight:bold;"/>

                    <Button text="Clientes" maxWidth="Infinity"/>
                    <Button text="Instalaciones" maxWidth="Infinity"/>
                    <Button text="Presupuestos" maxWidth="Infinity"/>

                </VBox>
            </left>

            <!-- CONTENIDO -->
            <center>

                <VBox spacing="20" style="-fx-padding:20;">

                    <!-- TITULO -->
                    <Label text="Vista General"
                           style="-fx-font-size:22px; -fx-font-weight:bold;"/>

                    <!-- DASHBOARD -->
                    <!-- DASHBOARD -->
                    <GridPane hgap="30" vgap="30" VBox.vgrow="NEVER">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="33.33"/>
                            <ColumnConstraints percentWidth="33.33"/>
                            <ColumnConstraints percentWidth="33.33"/>
                        </columnConstraints>

                        <rowConstraints>
                            <RowConstraints percentHeight="100"/>
                        </rowConstraints>

                        <!-- CLIENTES -->
                        <Button fx:id="btnClientes"
                                contentDisplay="TOP"
                                styleClass="dashboard-button"
                                maxWidth="Infinity"
                                maxHeight="Infinity"
                                onAction="#abrirClientes"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="0"/>

                        <!-- PRESUPUESTOS -->
                        <Button fx:id="btnPresupuestos"
                                contentDisplay="TOP"
                                styleClass="dashboard-button"
                                maxWidth="Infinity"
                                maxHeight="Infinity"
                                onAction="#abrirPresupuestos"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="0"/>

                        <!-- INSTALACIONES -->
                        <Button fx:id="btnInstalaciones"
                                contentDisplay="TOP"
                                styleClass="dashboard-button"
                                maxWidth="Infinity"
                                maxHeight="Infinity"
                                onAction="#abrirInstalaciones"
                                GridPane.columnIndex="2"
                                GridPane.rowIndex="0"/>

                    </GridPane>

                    <!-- TABLA CLIENTES -->
                    <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">

                        <columns>
                            <TableColumn text="ID" prefWidth="80"/>
                            <TableColumn text="Nombre" prefWidth="200"/>
                            <TableColumn text="Teléfono" prefWidth="150"/>
                            <TableColumn text="Email" prefWidth="200"/>
                            <TableColumn text="Dirección" prefWidth="250"/>
                        </columns>

                    </TableView>

                </VBox>

            </center>

        </BorderPane>

    </children>

</AnchorPane>