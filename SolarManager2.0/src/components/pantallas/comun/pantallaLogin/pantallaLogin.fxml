<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="components.pantallas.comun.pantallaLogin.PantallaLoginController"> 

    <VBox alignment="CENTER"
          spacing="20"
          prefWidth="380"
          maxWidth="380"
          style="-fx-padding:40;">

        <!-- TITULO -->

        <Label text="Solar Manager"
               style="-fx-font-size:34px; -fx-font-weight:bold;"/>

        <!-- LOGO -->

        <ImageView fx:id="imgLogo"
                   fitWidth="220"
                   preserveRatio="true"/>

        <!-- USUARIO -->

        <VBox spacing="5" alignment="CENTER_LEFT">

            <Label text="Usuario"/>

            <TextField fx:id="txtUsuario"
                       prefWidth="250"/>

        </VBox>

        <!-- PASSWORD -->

        <VBox spacing="5" alignment="CENTER_LEFT">

            <Label text="Password"/>

            <PasswordField fx:id="txtPassword"
                           prefWidth="250"/>

        </VBox>

        <!-- BOTONES -->

        <HBox alignment="CENTER" spacing="15">

            <Button fx:id="btnAceptar"
                    text="Aceptar"
                    prefWidth="110"
                    defaultButton="true"
                    onAction="#handleAceptar"/>

            <Button fx:id="btnCancelar"
                text="Cancelar"
                prefWidth="110"
                defaultButton="true"
                onAction="#handleCancelar"/>

        </HBox>
        
        <Label fx:id="lblMensaje"
       textFill="red"
       style="-fx-font-size: 14px;"
       wrapText="true" />

    </VBox>

</StackPane>