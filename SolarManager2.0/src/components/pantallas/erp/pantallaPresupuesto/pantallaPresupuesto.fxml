<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="800" prefWidth="1200" styleClass="mainFxmlClass" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="components.pantallas.erp.pantallaPresupuesto.PantallaPresupuestoController">

    <stylesheets>
        <URL value="@pantallapresupuesto.css" />
    </stylesheets>

    <children>

        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <!-- CINTA SUPERIOR -->

            <top>
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color:#f4f4f4; -fx-padding:10;">

                    <Button fx:id="btnVolver" text="← Volver" />

                    <Label style="-fx-font-size:18px; -fx-font-weight:bold;" text="Solar Manager" />

                    <Pane HBox.hgrow="ALWAYS" />

                </HBox>
            </top>


            <!-- MENU LATERAL -->

            <left>

                <VBox alignment="TOP_CENTER" prefHeight="509.0" prefWidth="150" spacing="10" style="                             -fx-background-color:#e6e9ef;                             -fx-padding:20;                             -fx-border-color:#d0d0d0;                             -fx-border-width:2;                             -fx-background-radius:5;                             -fx-border-radius:5;">

                    <Label style="-fx-font-weight:bold;" text="Inicio" />

                    <Button maxWidth="Infinity" text="Clientes" />
                    <Button maxWidth="Infinity" text="Comerciales" />
                    <Button maxWidth="Infinity" text="Proveedores" />
                    <Button maxWidth="Infinity" text="Stock" />
                    <Button maxWidth="Infinity" text="Presupuestos" />

                </VBox>

            </left>


            <!-- DASHBOARD CENTRAL -->

            <center>

                <VBox spacing="15" style="-fx-padding:15;">

                    <!-- TITULO -->

                    <Label fx:id="lblTituloPagina" style="-fx-font-size:18px; -fx-font-weight:bold;" text="Presupuestos" />


                    <!-- TABLA DE PRESUPUESTOS -->

                    <TableView fx:id="tablaPresupuestos" VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="colId" prefWidth="70" text="ID" />
                            <TableColumn fx:id="colIdCliente" prefWidth="300.0" text="Cliente" />
                            <TableColumn fx:id="colIdComercial" prefWidth="179.0" text="Comercial" />
                            <TableColumn fx:id="colFechaCreacion" prefWidth="78.0" text="Fecha" />
                            <TableColumn fx:id="colEstado" prefWidth="83.0" text="Estado" />
                            <TableColumn fx:id="colSubtotal" prefWidth="119.0" text="Subtotal" />
                            <TableColumn fx:id="colIva" prefWidth="68.0" text="IVA" />
                            <TableColumn fx:id="colTotal" prefWidth="120.0" text="Total" />

                        </columns>

                    </TableView>
                      <!-- ESPACIO FLEXIBLE REDUCIDO -->

                    <Pane prefHeight="100" style="                                 -fx-background-color:white;                                 -fx-border-color:#d0d0d0;                                 -fx-border-width:2;                                 -fx-border-radius:5;                                 -fx-background-radius:5;" />


                    <!-- BOTONES -->

                    <HBox alignment="CENTER_RIGHT" spacing="10">

                        <Button fx:id="btnGuardar" text="Guardar" />
                        <Button fx:id="btnModificar" text="Modificar" />
                        <Button fx:id="btnCancelar" text="Cancelar" />

                    </HBox>

                </VBox>

            </center>

        </BorderPane>

    </children>

</AnchorPane>
