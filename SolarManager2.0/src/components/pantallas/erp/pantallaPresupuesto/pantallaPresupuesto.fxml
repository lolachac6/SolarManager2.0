<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="800.00"
            prefWidth="1200.0"
            styleClass="mainFxmlClass"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="components.pantallas.erp.pantallaPresupuesto.PantallaPresupuestoController">

    <stylesheets>
        <URL value="@pantallapresupuesto.css"/>
    </stylesheets>

    <children>

        <BorderPane AnchorPane.topAnchor="0"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0">

            <!-- CABECERA -->
            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="10"
                      style="-fx-background-color:#f4f4f4; -fx-padding:10;">

                    <Button fx:id="btnVolver"
                            text="← Volver"
                            onAction="#volverInicio"/>

                    <Label text="Solar Manager"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

                    <Pane HBox.hgrow="ALWAYS"/>

                </HBox>
            </top>

            <!-- MENU LATERAL -->
            <left>

                <VBox alignment="TOP_CENTER"
                      prefWidth="200"
                      spacing="10"
                      style="
                            -fx-background-color:#e6e9ef;
                            -fx-padding:85 15 15 15;
                            -fx-border-color:#d0d0d0;
                            -fx-border-width:2;
                            -fx-background-radius:5;
                            -fx-border-radius:5;">

                    <BorderPane.margin>
                        <Insets top="90" right="15" bottom="65" left="15"/>
                    </BorderPane.margin>

                    <Label text="Inicio"
                           style="-fx-font-weight:bold;"/>

                    <Button text="Clientes"
                            maxWidth="Infinity"
                            styleClass="menu-button"
                            onAction="#irClientes"/>

                    <Button text="Comerciales"
                            maxWidth="Infinity"
                            styleClass="menu-button"
                            onAction="#irComerciales"/>

                    <Button text="Proveedores"
                            maxWidth="Infinity"
                            styleClass="menu-button"
                            onAction="#irProveedores"/>

                    <Button text="Stock"
                            maxWidth="Infinity"
                            styleClass="menu-button"
                            onAction="#irStock"/>

                    <Button text="Presupuestos"
                            maxWidth="Infinity"
                            styleClass="menu-button"
                            onAction="#irPresupuestos"/>

                    <Button text="Informes"
                            maxWidth="Infinity"
                            styleClass="menu-button"
                            onAction="#irInformes"/>

                </VBox>

            </left>

            <!-- CONTENIDO -->
            <center>

                <VBox spacing="20" style="-fx-padding:20;">

                    <!-- TITULO -->
                    <Label text="Presupuestos"
                           style="-fx-font-size:22px; -fx-font-weight:bold;"/>

                    <!-- FILTRO -->
                    <HBox spacing="10">

                        <TextField fx:id="txtFiltro"
                                   promptText="Buscar presupuesto..."
                                   HBox.hgrow="ALWAYS"/>

                        <Button fx:id="btnBuscar"
                                text="🔍"
                                prefWidth="40"/>

                    </HBox>

                    <!-- TABLA -->
                    <TableView fx:id="tablaPresupuestos"
                               VBox.vgrow="ALWAYS"
                               style="
                                    -fx-border-color:#d0d0d0;
                                    -fx-border-width:2;">

                        <columns>

                            <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                            <TableColumn fx:id="colIdCliente" text="Cliente" prefWidth="300"/>
                            <TableColumn fx:id="colIdComercial" text="Comercial" prefWidth="180"/>
                            <TableColumn fx:id="colFechaCreacion" text="Fecha" prefWidth="100"/>
                            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                            <TableColumn fx:id="colSubtotal" text="Subtotal" prefWidth="120"/>
                            <TableColumn fx:id="colIva" text="IVA" prefWidth="80"/>
                            <TableColumn fx:id="colTotal" text="Total" prefWidth="120"/>

                        </columns>

                    </TableView>

                    <!-- PANEL INFERIOR -->
                    <Pane prefHeight="100"
                          style="
                                -fx-background-color:white;
                                -fx-border-color:#d0d0d0;
                                -fx-border-width:2;
                                -fx-border-radius:5;
                                -fx-background-radius:5;"/>

                    <!-- BOTONES -->
                    <HBox spacing="10">
                        <Button fx:id="btnnuevoPresupeusto"
                                text="➕ Añadir Presupuesto"/>

                        <Button fx:id="btnHacerFactura"
                                text="Hacer factura"/>

                        <Pane HBox.hgrow="ALWAYS"/>

                        <Button fx:id="btnGuardar"
                                text="Guardar"
                                style="-fx-background-color:#2f6fda; -fx-text-fill:white;"/>

                        
                        <Button fx:id="btnModificar" text="Modificar"/>
                        
                        <Button fx:id="btnCancelar" text="Cancelar"/>

                    </HBox>

                </VBox>

            </center>

        </BorderPane>

    </children>

</AnchorPane>