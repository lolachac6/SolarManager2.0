<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0"
            prefWidth="1000.0"
            style="-fx-background-color:#f4f6f8;"
            xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="components.pantallas.erp.pantallaModificacionPresupuesto.PantallaModificacionPresupuestoController">

    <children>

        <VBox spacing="15"
              style="-fx-padding:20;"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">

            <Label text="Modificar Presupuesto"
                   style="-fx-font-size:24px; -fx-font-weight:bold;" />

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="18" style="-fx-padding:5;">

                        <VBox spacing="12"
                              style="-fx-background-color:#eef3f7;
                                     -fx-border-color:#cfd8e3;
                                     -fx-border-width:2;
                                     -fx-border-radius:8;
                                     -fx-background-radius:8;
                                     -fx-padding:18;">

                            <Label text="Datos Cliente"
                                   style="-fx-font-size:18px; -fx-font-weight:bold;" />

                            <GridPane hgap="15" vgap="12">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50.0" />
                                    <ColumnConstraints percentWidth="50.0" />
                                </columnConstraints>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Nombre" />
                                    <TextField fx:id="txtNombre" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Apellidos" />
                                    <TextField fx:id="txtApellidos" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="DNI / CIF" />
                                    <TextField fx:id="txtDocumento" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="Tipo de Cliente" />
                                    <TextField fx:id="txtTipoCliente" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="Calle" />
                                    <TextField fx:id="txtCalle" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label text="Número" />
                                    <TextField fx:id="txtNumero" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3">
                                    <Label text="Localidad" />
                                    <TextField fx:id="txtLocalidad" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3">
                                    <Label text="Código Postal" />
                                    <TextField fx:id="txtCodigoPostal" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="4" GridPane.columnSpan="2">
                                    <Label text="Provincia" />
                                    <TextField fx:id="txtProvincia" />
                                </VBox>
                            </GridPane>
                        </VBox>

                        <VBox spacing="12"
                              style="-fx-background-color:#eef3f7;
                                     -fx-border-color:#cfd8e3;
                                     -fx-border-width:2;
                                     -fx-border-radius:8;
                                     -fx-background-radius:8;
                                     -fx-padding:18;">

                            <Label text="Datos de Instalación"
                                   style="-fx-font-size:18px; -fx-font-weight:bold;" />

                            <GridPane hgap="15" vgap="12">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50.0" />
                                    <ColumnConstraints percentWidth="50.0" />
                                </columnConstraints>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <Label text="Paneles solares" />
                                    <TextField fx:id="txtPanelesSolares" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <Label text="Soportes / Estructura" />
                                    <TextField fx:id="txtEstructura" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <Label text="Inversor" />
                                    <TextField fx:id="txtInversor" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <Label text="Batería" />
                                    <TextField fx:id="txtBateria" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                    <Label text="Material eléctrico" />
                                    <TextField fx:id="txtMaterialElectrico" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                    <Label text="Mano de obra" />
                                    <TextField fx:id="txtManoObra" />
                                </VBox>

                                <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.columnSpan="2">
                                    <Label text="Tramitación de subvenciones y gestiones administrativas" />
                                    <TextField fx:id="txtTramitacion" />
                                </VBox>
                            </GridPane>
                        </VBox>

                    </VBox>
                </content>
            </ScrollPane>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="Estado" />
                    <ComboBox fx:id="comboEstado" prefWidth="220.0" />
                </VBox>

                <AnchorPane HBox.hgrow="ALWAYS" />

                <Button onAction="#cancelar"
                        text="Cancelar"
                        style="-fx-min-width:120;" />

                <Button onAction="#guardarCambios"
                        text="Guardar"
                        style="-fx-min-width:120; -fx-background-color:#2f6fda; -fx-text-fill:white;" />
            </HBox>

        </VBox>

    </children>
</AnchorPane>