<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.00" prefWidth="1200.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="components.pantallas.erp.pantallaProveedor.PantallaProveedorController">

    <stylesheets>
        <URL value="@pantallaproveedor.css" />
    </stylesheets>

    <children>

        <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <!-- CABECERA -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color:#f4f4f4; -fx-padding:10;">

                    <Button fx:id="btnVolver" onAction="#volverInicio" text="← Volver" />

                    <Label style="-fx-font-size:18px; -fx-font-weight:bold;" text="Solar Manager" />

                    <Pane HBox.hgrow="ALWAYS" />

                </HBox>
            </top>

            <!-- MENU LATERAL -->
            <left>

                <VBox alignment="TOP_CENTER" prefWidth="200" spacing="10" style="                             -fx-background-color:#e6e9ef;                             -fx-padding:85 15 15 15;                             -fx-border-color:#d0d0d0;                             -fx-border-width:2;                             -fx-background-radius:5;                             -fx-border-radius:5;">

                    <BorderPane.margin>
                        <Insets bottom="65" left="15" right="15" top="90" />
                    </BorderPane.margin>

                    <Label style="-fx-font-weight:bold;" text="Inicio" />

                    <Button maxWidth="Infinity" onAction="#irClientes" styleClass="menu-button" text="Clientes" />

                    <Button maxWidth="Infinity" onAction="#irComerciales" styleClass="menu-button" text="Comerciales" />

                    <Button maxWidth="Infinity" onAction="#irProveedores" styleClass="menu-button" text="Proveedores" />

                    <Button maxWidth="Infinity" onAction="#irStock" styleClass="menu-button" text="Stock" />

                    <Button maxWidth="Infinity" onAction="#irPresupuestos" styleClass="menu-button" text="Presupuestos" />
                    
                    <Button maxWidth="Infinity" onAction="#irInstalaciones" styleClass="menu-button" text="Instalaciones" />

                    <Button maxWidth="Infinity" onAction="#irInformes" styleClass="menu-button" text="Informes" />
                    
                    

                </VBox>

            </left>

            <!-- CONTENIDO -->
            <center>

                <VBox spacing="20" style="-fx-padding:20;">

                    <Label style="-fx-font-size:22px; -fx-font-weight:bold;" text="Proveedores" />

                    <!-- FILTRO -->
                    <HBox spacing="10">

                        <TextField fx:id="txtFiltro" promptText="Buscar proveedor..." HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnBuscar" prefWidth="40" text="🔍" />

                    </HBox>

                    <!-- TABLA -->
                    <TableView fx:id="tablaProveedores" style="-fx-border-color:#d0d0d0; -fx-border-width:2;" VBox.vgrow="ALWAYS">

                        <columns>

                            <TableColumn fx:id="colId" prefWidth="100" text="ID" />
                            <TableColumn fx:id="colNombre" prefWidth="250" text="Nombre" />
                            <TableColumn fx:id="colTelefono" prefWidth="150" text="Teléfono" />
                            <TableColumn fx:id="colEmail" prefWidth="200" text="Email" />
                            <TableColumn fx:id="colDireccion" prefWidth="250" text="Dirección" />

                        </columns>

                    </TableView>

                    <!-- PANEL INFERIOR -->
                    <Pane prefHeight="100" style="-fx-background-color:white; -fx-border-color:#d0d0d0; -fx-border-width:2; -fx-border-radius:5; -fx-background-radius:5;" />

                    <!-- BOTONES -->
                    <HBox spacing="10">

                        <Button onAction="#abrirAltaProveedor" style="-fx-background-color: #2f6fda; -fx-text-fill: white;" text="➕ Añadir proveedor" />

                        <Pane HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnActualizar" onAction="#actualizar" text="Actualizar" />

                        <Button fx:id="btnDetalle" onAction="#detalle" text="Detalle" />
                  <Button onAction="#eliminarProveedor" text="Eliminar" />

                    </HBox>

                </VBox>

            </center>

        </BorderPane>

    </children>

</AnchorPane>
