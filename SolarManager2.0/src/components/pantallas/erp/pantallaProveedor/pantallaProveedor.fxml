<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane styleClass="mainFxmlClass"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="components.pantallas.erp.pantallaProveedor.PantallaProveedorController">

    <stylesheets>
        <URL value="@pantallaproveedor.css" />
    </stylesheets>

    <children>

        <BorderPane AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">

            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="10"
                      style="-fx-background-color:#f4f4f4; -fx-padding:10;">

                    <Button fx:id="btnVolver"
                            onAction="#volverInicio"
                            text="← Volver" />

                    <Label style="-fx-font-size:18px; -fx-font-weight:bold;"
                           text="Solar Manager" />

                    <Pane HBox.hgrow="ALWAYS" />

                </HBox>
            </top>

            <left>
                <VBox alignment="TOP_CENTER"
                      prefWidth="200"
                      spacing="10"
                      style="-fx-background-color:#e6e9ef;
                             -fx-padding:85 15 15 15;
                             -fx-border-color:#d0d0d0;
                             -fx-border-width:2;
                             -fx-background-radius:5;
                             -fx-border-radius:5;">

                    <BorderPane.margin>
                        <Insets bottom="65" left="15" right="15" top="90" />
                    </BorderPane.margin>

                    <Label style="-fx-font-weight:bold;" text="Inicio" />

                    <Button maxWidth="Infinity" onAction="#irClientes" styleClass="menu-button" text="Clientes" />
                    <Button maxWidth="Infinity" onAction="#irComerciales" styleClass="menu-button" text="Comerciales" />
                    <Button maxWidth="Infinity" onAction="#irProveedores" styleClass="menu-button" text="Proveedores" />
                    <Button maxWidth="Infinity" onAction="#irStock" styleClass="menu-button" text="Stock" />
                    <Button maxWidth="Infinity" onAction="#irPresupuestos" styleClass="menu-button" text="Presupuestos" />
                    <Button maxWidth="Infinity" onAction="#irInstalaciones" styleClass="menu-button" text="Instalaciones" />
                    <Button maxWidth="Infinity" onAction="#irInformes" styleClass="menu-button" text="Informes" />

                </VBox>
            </left>

            <center>
                <AnchorPane>
                    <children>
                        <VBox spacing="20"
                              fillWidth="true"
                              maxWidth="Infinity"
                              maxHeight="Infinity"
                              style="-fx-padding:20;"
                              AnchorPane.topAnchor="0.0"
                              AnchorPane.bottomAnchor="0.0"
                              AnchorPane.leftAnchor="0.0"
                              AnchorPane.rightAnchor="0.0">

                            <Label style="-fx-font-size:22px; -fx-font-weight:bold;"
                                   text="Proveedores" />

                            <HBox spacing="10">

                                <TextField fx:id="txtFiltro"
                                           promptText="Buscar proveedor..."
                                           HBox.hgrow="ALWAYS" />

                                <Button fx:id="btnBuscar"
                                        prefWidth="40"
                                        text="🔍" />

                            </HBox>

                            <TableView fx:id="tablaProveedores"
                            maxWidth="Infinity"
                            maxHeight="Infinity"
                            style="-fx-border-color:#d0d0d0; -fx-border-width:2;"
                            VBox.vgrow="ALWAYS">

                     <columns>
                         <TableColumn fx:id="colId" prefWidth="100" text="ID" />
                         <TableColumn fx:id="colNombreEmpresa" prefWidth="250" text="Nombre de la Empresa" />
                         <TableColumn fx:id="colRazonSocial" prefWidth="200" text="Razón Social" />
                         <TableColumn fx:id="colCif" prefWidth="150" text="CIF" />
                         <TableColumn fx:id="colTelefono" prefWidth="150" text="Teléfono" />
                         <TableColumn fx:id="colEmail" prefWidth="200" text="Email" />
                         <TableColumn fx:id="colDireccion" prefWidth="250" text="Dirección" />
                     </columns>

                 </TableView>

                            <Pane prefHeight="100"
                                  maxWidth="Infinity"
                                  style="-fx-background-color:white;
                                         -fx-border-color:#d0d0d0;
                                         -fx-border-width:2;
                                         -fx-border-radius:5;
                                         -fx-background-radius:5;" />

                            <HBox spacing="10">

                                <Button onAction="#abrirAltaProveedor"
                                        style="-fx-background-color: #2f6fda; -fx-text-fill: white;"
                                        text="➕ Añadir proveedor" />

                                <Pane HBox.hgrow="ALWAYS" />
                                
                                <Button fx:id="btnDetalle"
                                        onAction="#detalle"
                                        text="Detalle" />

                                <Button fx:id="btnModificar"
                                        onAction="#modificar"
                                        text="Modificar" />

                                <Button onAction="#eliminarProveedor"
                                        text="Eliminar" />

                            </HBox>

                        </VBox>
                    </children>
                </AnchorPane>
            </center>

        </BorderPane>

    </children>

</AnchorPane>