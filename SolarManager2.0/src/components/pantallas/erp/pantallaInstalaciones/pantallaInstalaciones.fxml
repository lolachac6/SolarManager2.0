<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane styleClass="mainFxmlClass"
            xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="components.pantallas.erp.pantallaInstalaciones.PantallaInstalacionesController">

    <stylesheets>
        <URL value="@pantallainstalaciones.css" />
    </stylesheets>

    <children>

        <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <top>
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color:#f4f4f4; -fx-padding:10;">
                    <Button onAction="#volverInicio" text="← Volver" />
                    <Label style="-fx-font-size:18px; -fx-font-weight:bold;" text="Solar Manager" />
                    <Pane HBox.hgrow="ALWAYS" />
                </HBox>
            </top>

            <left>
                <VBox alignment="TOP_CENTER"
                      prefWidth="200"
                      spacing="10"
                      style="-fx-background-color:#e6e9ef;
                             -fx-padding:85 15 15 15;
                             -fx-border-color:#d0d0d0;
                             -fx-border-width:2;
                             -fx-background-radius:5;
                             -fx-border-radius:5;">

                    <BorderPane.margin>
                        <Insets bottom="65" left="15" right="15" top="90" />
                    </BorderPane.margin>

                    <Label style="-fx-font-weight:bold;" text="Inicio" />

                    <Button maxWidth="Infinity" onAction="#irClientes" styleClass="menu-button" text="Clientes" />
                    <Button maxWidth="Infinity" onAction="#irComerciales" styleClass="menu-button" text="Comerciales" />
                    <Button maxWidth="Infinity" onAction="#irProveedores" styleClass="menu-button" text="Proveedores" />
                    <Button maxWidth="Infinity" onAction="#irStock" styleClass="menu-button" text="Stock" />
                    <Button maxWidth="Infinity" onAction="#irPresupuestos" styleClass="menu-button" text="Presupuestos" />
                    <Button maxWidth="Infinity" onAction="#irInstalaciones" styleClass="menu-button" text="Instalaciones" />
                    <Button maxWidth="Infinity" onAction="#irInformes" styleClass="menu-button" text="Informes" />
                </VBox>
            </left>

            <center>
                <VBox spacing="20" style="-fx-padding:20;">

                    <Label style="-fx-font-size:22px; -fx-font-weight:bold;" text="Instalaciones Fotovoltaicas" />

                    <HBox spacing="10">
                        <TextField fx:id="txtFiltro" promptText="Buscar instalación..." HBox.hgrow="ALWAYS" />
                        <Button onAction="#buscar" text="🔍" />
                    </HBox>

                    <TableView fx:id="tablaInstalaciones" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colCliente" prefWidth="260" text="Cliente" />
                            <TableColumn fx:id="colDireccion" prefWidth="260" text="Dirección" />
                            <TableColumn fx:id="colPaneles" prefWidth="100" text="Paneles" />
                            <TableColumn fx:id="colPotencia" prefWidth="120" text="Potencia (kW)" />
                            <TableColumn fx:id="colInversor" prefWidth="180" text="Inversor" />
                            <TableColumn fx:id="colBateria" prefWidth="100" text="Batería" />
                          
                        </columns>
                    </TableView>

                    <Pane prefHeight="100"
                          style="-fx-background-color:white;
                                 -fx-border-color:#d0d0d0;
                                 -fx-border-width:2;
                                 -fx-border-radius:5;
                                 -fx-background-radius:5;"/>
                    
                    
                    <HBox spacing="10" alignment="CENTER_LEFT">

                        <!-- IZQUIERDA -->
                        <Button onAction="#hacerPresupuesto" text="Hacer Presupuesto"
                                style="-fx-background-color:#2f6fda; -fx-text-fill:white;"/>
                        
                        <!-- SEPARADOR -->
                        <Pane HBox.hgrow="ALWAYS"/>
                        
                        <!-- DERECHA -->
                        
                        <Button onAction="#verDetalle" text="Detalle"/>
                        <Button onAction="#eliminar" text="Eliminar"/>
                        

                    </HBox>
                </VBox>
            </center>

        </BorderPane>

    </children>

</AnchorPane>