<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="components.pantallas.erp.pantallaAltaProducto.PantallaAltaProductoController">

    <stylesheets>
        <URL value="@pantallaaltaproducto.css" />
    </stylesheets>

    <children>

        <BorderPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <!-- ===================== -->
            <!-- CABECERA -->
            <!-- ===================== -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color:#f4f4f4; -fx-padding:10;">

                    <Button onAction="#volver" text="← Volver" />

                    <Label style="-fx-font-size:18px; -fx-font-weight:bold;" text="Alta de Producto" />

                    <Pane HBox.hgrow="ALWAYS" />

                </HBox>
            </top>

            <!-- ===================== -->
            <!-- FORMULARIO -->
            <!-- ===================== -->
            <center>
                <VBox spacing="20" style="-fx-padding:20;">

                    <!-- TÍTULO -->
                    <Label style="-fx-font-size:22px; -fx-font-weight:bold;" text="Datos del Producto" />

                    <!-- PANEL PRINCIPAL -->
                    <VBox spacing="20" style="                             -fx-background-color:white;                             -fx-border-color:#d0d0d0;                             -fx-border-width:2;                             -fx-border-radius:5;                             -fx-background-radius:5;                             -fx-padding:25;                           ">

                        <GridPane hgap="20" vgap="15">

                            <columnConstraints>
                                <ColumnConstraints percentWidth="30" />
                                <ColumnConstraints percentWidth="70" />
                            </columnConstraints>

                            <!-- NOMBRE -->
                            <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                            <!-- TIPO -->
                            <Label text="Tipo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                            <ComboBox fx:id="cmbTipo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                            <!-- PRECIO -->
                            <Label text="Precio (€):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                            <!-- STOCK -->
                            <Label text="Stock:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                            <TextField fx:id="txtStock" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                            <!-- PROVEEDOR -->
                            <Label text="Proveedor:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                            <ComboBox fx:id="cmbProveedor" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                            <!-- DESCRIPCIÓN -->
                            <Label text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                            <TextArea fx:id="txtDescripcion" prefRowCount="3" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                     <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                     </rowConstraints>

                        </GridPane>

                    </VBox>

                    <!-- ESPACIO FLEXIBLE -->
                    <Pane VBox.vgrow="ALWAYS" />

                    <!-- BOTONES -->
                    <HBox alignment="CENTER_RIGHT" spacing="15" style="-fx-padding:0 0 10 0;">

                        <Button onAction="#guardarProducto" styleClass="btn-guardar" text="Guardar" />

                        <Button onAction="#cancelar" styleClass="btn-cancelar" text="Cancelar" />

                    </HBox>

                </VBox>
            </center>

        </BorderPane>

    </children>

</AnchorPane>
