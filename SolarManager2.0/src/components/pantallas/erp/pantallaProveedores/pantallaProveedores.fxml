<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane"
            prefHeight="800.0"
            prefWidth="1200.0"
            styleClass="mainFxmlClass"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="components.pantallas.erp.pantallaProveedores.PantallaProveedoresController">

    <stylesheets>
        <URL value="@plantillageneral.css" />
    </stylesheets>

    <children>

        <BorderPane
                AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0"
                AnchorPane.topAnchor="0">

            <!-- CINTA SUPERIOR -->

            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="10"
                      style="-fx-background-color:#f4f4f4; -fx-padding:10;">

                    <Button fx:id="btnVolver" text="← Volver" />

                    <Label text="Solar Manager"
                           style="-fx-font-size:18px; -fx-font-weight:bold;" />

                    <Pane HBox.hgrow="ALWAYS" />

                </HBox>
            </top>


            <!-- MENU LATERAL -->

            <left>

                <VBox alignment="TOP_CENTER"
                      prefWidth="200"
                      spacing="10"
                      style="
                            -fx-background-color:#e6e9ef;
                            -fx-padding:85 15 15 15;
                            -fx-border-color:#d0d0d0;
                            -fx-border-width:2;
                            -fx-background-radius:5;
                            -fx-border-radius:5;">

                    <BorderPane.margin>
                        <Insets top="90.0" right="15.0" bottom="65.0" left="15.0" />
                    </BorderPane.margin>

                    <Label text="Inicio"
                           style="-fx-font-weight:bold;" />

                    <Button text="Clientes" maxWidth="Infinity" />
                    <Button text="Comerciales" maxWidth="Infinity" />
                    <Button text="Proveedores" maxWidth="Infinity" />
                    <Button text="Stock" maxWidth="Infinity" />
                    <Button text="Presupuestos" maxWidth="Infinity" />

                </VBox>

            </left>


            <!-- DASHBOARD CENTRAL -->

            <center>

                <VBox spacing="20"
                      style="-fx-padding:20;">

                    <!-- TITULO -->

                    <Label fx:id="lblTituloPagina"
                           text="Proveedores"
                           style="-fx-font-size:22px; -fx-font-weight:bold;" />


                    <!-- TABLA DE PROVEEDORES -->

                    <TableView fx:id="tablaProveedores"
                               VBox.vgrow="ALWAYS"
                               style="
                                    -fx-border-color:#d0d0d0;
                                    -fx-border-width:2;">

                        <columns>

                            <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                            <TableColumn fx:id="colNombre" prefWidth="120" text="Nombre" />
                            <TableColumn fx:id="colApellidos" prefWidth="140" text="Apellidos" />
                            <TableColumn fx:id="colTelefono" prefWidth="120" text="Teléfono" />
                            <TableColumn fx:id="colEmail" prefWidth="180" text="Email" />
                            <TableColumn fx:id="colDireccion" prefWidth="180" text="Dirección" />
                            <TableColumn fx:id="colNombreEmpresa" prefWidth="160" text="Empresa" />
                            <TableColumn fx:id="colWeb" prefWidth="160" text="Web" />
                            <TableColumn fx:id="colObservaciones" prefWidth="220" text="Observaciones" />

                        </columns>

                    </TableView>


                    <!-- ESPACIO FLEXIBLE REDUCIDO -->

                    <Pane prefHeight="100"
                          style="
                                -fx-background-color:white;
                                -fx-border-color:#d0d0d0;
                                -fx-border-width:2;
                                -fx-border-radius:5;
                                -fx-background-radius:5;" />


                    <!-- BOTONES INFERIORES -->

                    <HBox alignment="CENTER_RIGHT"
                          spacing="10">

                        <Button fx:id="btnGuardar"
                                text="Guardar"
                                style="-fx-background-color:#2f6fda; -fx-text-fill:white;" />

                        <Button fx:id="btnModificar" text="Modificar" />

                        <Button fx:id="btnCancelar" text="Cancelar" />

                    </HBox>

                </VBox>

            </center>

        </BorderPane>

    </children>

</AnchorPane>