<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="800.0"
            prefWidth="1200.0"
            styleClass="mainFxmlClass"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="components.pantallas.erp.pantallaClientes.PantallaClientesController">

    <stylesheets>
        <URL value="@pantallaclientes.css"/>
    </stylesheets>

    <children>

        <BorderPane AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0"
                    AnchorPane.topAnchor="0">

            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="10"
                      style="-fx-background-color:#f4f4f4; -fx-padding:10;">

                    <Button fx:id="btnVolver"
                            text="← Volver"
                            onAction="#volverInicio"/>

                    <Label text="Solar Manager"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

                    <Pane HBox.hgrow="ALWAYS"/>

                </HBox>
            </top>

            <!-- MENU LATERAL -->
            <left>
                <VBox alignment="TOP_CENTER" prefWidth="200" spacing="10" style="-fx-background-color:#e6e9ef;                              -fx-padding:85 15 15 15;                              -fx-border-color:#d0d0d0;                              -fx-border-width:2;                              -fx-background-radius:5;                              -fx-border-radius:5;">

                    <BorderPane.margin>
                        <Insets bottom="65" left="15" right="15" top="90" />
                    </BorderPane.margin>

                    <Label style="-fx-font-weight:bold;" text="Inicio" />

                    <Button maxWidth="Infinity" onAction="#irClientes" styleClass="menu-button" text="Clientes" />

                    <Button maxWidth="Infinity" onAction="#irComerciales" styleClass="menu-button" text="Comerciales" />

                    <Button maxWidth="Infinity" onAction="#irProveedores" styleClass="menu-button" text="Proveedores" />

                    <Button maxWidth="Infinity" onAction="#irStock" styleClass="menu-button" text="Stock" />

                    <Button maxWidth="Infinity" onAction="#irPresupuestos" styleClass="menu-button" text="Presupuestos" />
                    
                    <Button maxWidth="Infinity" onAction="#irInstalaciones" styleClass="menu-button" text="Instalaciones" />

                    <Button maxWidth="Infinity" onAction="#irInformes" styleClass="menu-button" text="Informes" />
                    
                    
                </VBox>
            </left>

            <!-- CONTENIDO -->
            <center>
                <VBox spacing="20" style="-fx-padding:20;">

                    <Label text="Clientes"
                           style="-fx-font-size:22px; -fx-font-weight:bold;"/>

                    <HBox spacing="10">

                        <TextField fx:id="txtFiltro"
                                   promptText="Buscar cliente..."
                                   HBox.hgrow="ALWAYS"/>

                        <Button fx:id="btnBuscar"
                                prefWidth="40"
                                text="🔍"
                                onAction="#buscar"/>

                    </HBox>

                    <TableView fx:id="tablaClientes"
                               VBox.vgrow="ALWAYS"
                               style="-fx-border-color:#d0d0d0; -fx-border-width:2;">

                        <columns>
                            <TableColumn fx:id="colId" prefWidth="80" text="ID"/>
                            <TableColumn fx:id="colNombre" prefWidth="120" text="Nombre"/>
                            <TableColumn fx:id="colApellidos" prefWidth="140" text="Apellidos"/>
                            <TableColumn fx:id="colTelefono" prefWidth="100" text="Teléfono"/>
                            <TableColumn fx:id="colEmail" prefWidth="180" text="Email"/>
                            <TableColumn fx:id="colDireccion" prefWidth="220" text="Dirección"/>
                            <TableColumn fx:id="colTipoCliente" prefWidth="100" text="Tipo"/>
                            <TableColumn fx:id="colDni" prefWidth="100" text="DNI"/>
                            <TableColumn fx:id="colCif" prefWidth="100" text="CIF"/>
                            <TableColumn fx:id="colObservaciones" prefWidth="150" text="Observaciones"/>
                            <TableColumn fx:id="colIdComercialAsignado" prefWidth="120" text="Comercial"/>
                        </columns>

                    </TableView>

                    <HBox spacing="10">
                        <Button text="➕ Añadir Cliente"
                                onAction="#añadirCliente"/>

                        <Button text="Calcular Instalación"
                                onAction="#calcularInstalacion"/>

                        <Button text="Modificar"
                                onAction="#modificar"/>

                        <Button text="Eliminar"
                                onAction="#eliminarCliente"/>

                        <Pane HBox.hgrow="ALWAYS"/>

                    </HBox>

                </VBox>
            </center>

        </BorderPane>

    </children>

</AnchorPane>