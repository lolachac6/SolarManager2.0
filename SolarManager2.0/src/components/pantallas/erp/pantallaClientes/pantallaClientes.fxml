<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="components.pantallas.erp.pantallaClientes.PantallaClientesController">

    <stylesheets>
        <URL value="@pantallaclientes.css" />
    </stylesheets>

    <children>

        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <top>
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color:#f4f4f4; -fx-padding:10;">

                    <Button fx:id="btnVolver" onAction="#volverInicio" text="← Volver" />

                    <Label style="-fx-font-size:18px; -fx-font-weight:bold;" text="Solar Manager" />

                    <Pane HBox.hgrow="ALWAYS" />

                </HBox>
            </top>

            <left>
                <VBox alignment="TOP_CENTER" prefWidth="200" spacing="10" style="-fx-background-color:#e6e9ef;                              -fx-padding:85 15 15 15;                              -fx-border-color:#d0d0d0;                              -fx-border-width:2;                              -fx-background-radius:5;                              -fx-border-radius:5;">

                    <BorderPane.margin>
                        <Insets bottom="65" left="15" right="15" top="90" />
                    </BorderPane.margin>

                    <Label style="-fx-font-weight:bold;" text="Inicio" />

                    <Button maxWidth="Infinity" onAction="#irClientes" styleClass="menu-button" text="Clientes" />
                    <Button maxWidth="Infinity" onAction="#irComerciales" styleClass="menu-button" text="Comerciales" />
                    <Button maxWidth="Infinity" onAction="#irProveedores" styleClass="menu-button" text="Proveedores" />
                    <Button maxWidth="Infinity" onAction="#irStock" styleClass="menu-button" text="Stock" />
                    <Button maxWidth="Infinity" onAction="#irPresupuestos" styleClass="menu-button" text="Presupuestos" />
                    <Button maxWidth="Infinity" onAction="#irInstalaciones" styleClass="menu-button" text="Instalaciones" />
                    <Button maxWidth="Infinity" onAction="#irInformes" styleClass="menu-button" text="Informes" />

                </VBox>
            </left>

            <center>
                <AnchorPane>
                    <children>
                        <VBox fillWidth="true" maxHeight="Infinity" maxWidth="Infinity" spacing="20" style="-fx-padding:20;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

                            <Label style="-fx-font-size:22px; -fx-font-weight:bold;" text="Clientes" />

                            <HBox spacing="10">

                                <TextField fx:id="txtFiltro" promptText="Buscar cliente..." HBox.hgrow="ALWAYS" />

                                <Button fx:id="btnBuscar" onAction="#buscar" prefWidth="40" text="🔍" />

                            </HBox>

                            <TableView fx:id="tablaClientes" maxHeight="Infinity" maxWidth="Infinity" style="-fx-border-color:#d0d0d0; -fx-border-width:2;" VBox.vgrow="ALWAYS">

                                <columns>
                                    <TableColumn fx:id="colCliente" prefWidth="200" text="Clientes" />
                                    <TableColumn fx:id="colTelefono" prefWidth="99.20001220703125" text="Teléfono" />
                                    <TableColumn fx:id="colEmail" prefWidth="178.39993286132812" text="Email" />
                                    <TableColumn fx:id="colDireccion" prefWidth="226.40008544921875" text="Dirección" />
                                    <TableColumn fx:id="colTipoCliente" prefWidth="104.0" text="Tipo" />
                                    <TableColumn fx:id="colDni" prefWidth="91.199951171875" text="DNI" />
                                    <TableColumn fx:id="colCif" prefWidth="106.4000244140625" text="CIF" />
                                    <TableColumn fx:id="colObservaciones" prefWidth="112.7999267578125" text="Observaciones" />
                                    <TableColumn fx:id="colIdComercialAsignado" prefWidth="111.2000732421875" text="Comercial" />
                                </columns>

                            </TableView>

                            <!-- PANEL INFERIOR -->
                            <Pane prefHeight="100" style="  -fx-background-color:white;  
                                                            -fx-border-color:#d0d0d0;-fx-border-width:2;   
                                                            -fx-border-radius:5;                                          
                                                            -fx-background-radius:5;" />

                            <HBox spacing="10" alignment="CENTER_LEFT">

                                <!-- IZQUIERDA -->
                                <Button fx:id="btnAñadirCliente"
                                        onAction="#añadirCliente"
                                        text="➕ Añadir Cliente"
                                        style="-fx-background-color:#2f6fda; -fx-text-fill:white;" />

                                <Button onAction="#calcularInstalacion"
                                        text="Calcular Instalación" />

                                <!-- SEPARADOR -->
                                <Pane HBox.hgrow="ALWAYS" />

                                <!-- DERECHA -->
                                <Button onAction="#detalle" text="Detalles" />
                                <Button onAction="#modificar" text="Modificar" />
                                <Button onAction="#eliminarCliente" text="Eliminar" />


                            </HBox>
                        </VBox>
                    </children>
                </AnchorPane>
            </center>

        </BorderPane>

    </children>

</AnchorPane>
