<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane id="AnchorPane"
            prefHeight="800.0"
            prefWidth="1200.0"
            styleClass="mainFxmlClass"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="components.pantallas.erp.pantallaProducto.PantallaProductoController">

    <stylesheets>
        <URL value="@pantallaproducto.css"/>
    </stylesheets>

    <children>

        <BorderPane AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">

            <!-- CINTA SUPERIOR -->

            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="10"
                      style="-fx-background-color:#f4f4f4; -fx-padding:10;">

                    <Button fx:id="btnVolver" text="← Volver"/>

                    <Label text="Solar Manager"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

                    <Pane HBox.hgrow="ALWAYS"/>

                </HBox>
            </top>


            <!-- MENU LATERAL -->

            <left>

                <VBox alignment="TOP_CENTER"
                      prefWidth="200"
                      spacing="10"
                      style="
                            -fx-background-color:#e6e9ef;
                            -fx-padding:85 15 15 15;
                            -fx-border-color:#d0d0d0;
                            -fx-border-width:2;
                            -fx-background-radius:5;
                            -fx-border-radius:5;">

                    <Label text="Inicio"
                           style="-fx-font-weight:bold;"/>

                    <Button text="Clientes" maxWidth="Infinity"/>
                    <Button text="Comerciales" maxWidth="Infinity"/>
                    <Button text="Proveedores" maxWidth="Infinity"/>
                    <Button text="Stock" maxWidth="Infinity"/>
                    <Button text="Presupuestos" maxWidth="Infinity"/>

                </VBox>

            </left>


            <!-- DASHBOARD CENTRAL -->

            <center>

                <VBox spacing="20"
                      style="-fx-padding:20;">

                    <!-- TITULO -->

                    <Label fx:id="lblTituloPagina"
                           text="Productos"
                           style="-fx-font-size:22px; -fx-font-weight:bold;"/>


                    <!-- TABLA DE PRODUCTOS -->

                    <TableView fx:id="tablaProductos"
                               VBox.vgrow="ALWAYS"
                               style="
                                    -fx-border-color:#d0d0d0;
                                    -fx-border-width:2;">

                        <columns>

                            <TableColumn fx:id="colId" prefWidth="120" text="ID"/>
                            <TableColumn fx:id="colNombre" prefWidth="220" text="Nombre"/>
                            <TableColumn fx:id="colTipoProducto" prefWidth="180" text="Tipo Producto"/>
                            <TableColumn fx:id="colPrecio" prefWidth="140" text="Precio (€)"/>
                            <TableColumn fx:id="colIdProveedor" prefWidth="180" text="Proveedor"/>
                            <TableColumn fx:id="colStock" prefWidth="120" text="Stock"/>

                        </columns>

                    </TableView>


                    <!-- ESPACIO FLEXIBLE -->

                    <Pane prefHeight="100"
                          style="
                                -fx-background-color:white;
                                -fx-border-color:#d0d0d0;
                                -fx-border-width:2;
                                -fx-border-radius:5;
                                -fx-background-radius:5;"/>


                    <!-- BOTONES INFERIORES -->

                    <HBox alignment="CENTER_RIGHT"
                          spacing="10">

                        <Button fx:id="btnGuardar"
                                text="Guardar"
                                style="-fx-background-color:#2f6fda; -fx-text-fill:white;"/>

                        <Button fx:id="btnModificar"
                                text="Modificar"/>

                        <Button fx:id="btnCancelar"
                                text="Cancelar"/>

                    </HBox>

                </VBox>

            </center>

        </BorderPane>

    </children>

</AnchorPane>