<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0"
            prefWidth="1000.0"
            styleClass="mainFxmlClass"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="components.pantallas.erp.pantallaAltaComercial.PantallaAltaComercialController">

    <stylesheets>
        <URL value="@pantallaaltacomercial.css"/>
    </stylesheets>

    <children>

        <BorderPane AnchorPane.topAnchor="0"
                    AnchorPane.bottomAnchor="0"
                    AnchorPane.leftAnchor="0"
                    AnchorPane.rightAnchor="0">

            <!-- ===================== -->
            <!-- CABECERA -->
            <!-- ===================== -->
            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="10"
                      style="-fx-background-color:#f4f4f4; -fx-padding:10;">

                    <Button text="← Volver" onAction="#volver"/>

                    <Label text="Alta Comercial"
                           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

                    <Pane HBox.hgrow="ALWAYS"/>

                </HBox>
            </top>

            <!-- ===================== -->
            <!-- FORMULARIO -->
            <!-- ===================== -->
            <center>
    <VBox spacing="20"
          style="-fx-padding:20;">

        <Label text="Datos del Comercial"
               style="-fx-font-size:22px; -fx-font-weight:bold;"/>

        <!-- PANEL PRINCIPAL (CON BORDE) -->
        <VBox spacing="20"
              style="
                -fx-background-color:white;
                -fx-border-color:#d0d0d0;
                -fx-border-width:2;
                -fx-border-radius:5;
                -fx-background-radius:5;
                -fx-padding:25;
              ">

            <GridPane hgap="20" vgap="15">

                <columnConstraints>
                    <ColumnConstraints percentWidth="30"/>
                    <ColumnConstraints percentWidth="70"/>
                </columnConstraints>

                <!-- CAMPOS -->
                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtNombre" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Apellidos:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtApellidos" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Teléfono:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtTelefono" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Email:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="txtEmail" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Dirección:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="txtDireccion" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Usuario:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="txtUsuario" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Contraseña:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <PasswordField fx:id="txtPassword" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <Label text="Activo:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <CheckBox fx:id="chkActivo"
                          GridPane.rowIndex="7" GridPane.columnIndex="1"/>

            </GridPane>

        </VBox>

        <!-- ESPACIO FLEXIBLE (CLAVE PARA ALINEAR BOTONES) -->
        <Pane VBox.vgrow="ALWAYS"/>

        <!-- BOTONES (ALINEACIÓN CONSISTENTE) -->
        <HBox spacing="15"
              alignment="CENTER_RIGHT"
              style="-fx-padding:0 0 10 0;">

            <Button text="Cancelar"
                    styleClass="btn-cancelar"
                    onAction="#cancelar"/>

            <Button text="Guardar"
                    styleClass="btn-guardar"
                    onAction="#guardarComercial"/>

        </HBox>

    </VBox>
</center>

                            <!-- BOTONES -->
                            <HBox alignment="CENTER_RIGHT" spacing="15">
                                <Button onAction="#guardarComercial" styleClass="btn-guardar" text="Guardar"/>
                                <Button onAction="#cancelar" styleClass="btn-cancelar" text="Cancelar"/>
                                
                            </HBox>

                        </VBox>
                    </content>
                </ScrollPane>
            </center>

        </BorderPane>

    </children>

</AnchorPane>